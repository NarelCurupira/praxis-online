{
  "name": "praxis-online",
  "private": true,
  "version": "0.10.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "check": "tsc --noEmit",
    "test:reports": "node --import tsx --test src/reporting.test.ts",
    "test:efficiency": "node --import tsx --test src/efficiency.test.ts",
    "test:time": "node --import tsx --test src/time-regression.test.ts",
    "test:reliability": "node --import tsx --test src/reliability.test.ts",
    "test:action-groups": "node --import tsx --test src/actionGroups.test.ts",
    "test:diagnostics": "node --import tsx --test src/diagnostics.test.ts",
    "test:data-quality": "node --import tsx --test src/dataQuality.test.ts",
    "test:intelligent-import": "node --import tsx --test src/intelligentImport.test.ts",
    "test:pwa": "node --import tsx --test src/pwa.test.ts",
    "test:passkeys": "node --import tsx --test src/passkeySupport.test.ts",
    "test:auth-method": "node --import tsx --test src/authenticationMethod.test.ts",
    "test:class-options": "node --import tsx --test src/classOptions.test.ts",
    "test:admin-users": "node --import tsx --test src/adminUserManagement.test.ts",
    "test": "npm run test:reports && npm run test:efficiency && npm run test:time && npm run test:reliability && npm run test:action-groups && npm run test:diagnostics && npm run test:data-quality && npm run test:intelligent-import && npm run test:pwa && npm run test:passkeys && npm run test:auth-method && npm run test:configuration-export && npm run test:layout-regression && npm run test:class-options && npm run test:admin-users",
    "report:sample": "node --import tsx scripts/generate-report-sample.ts",
    "report:scenarios": "node --import tsx scripts/generate-report-scenarios.ts",
    "test:configuration-export": "node --import tsx --test src/configurationExport.test.ts",
    "test:layout-regression": "node --import tsx --test src/layoutRegression.test.ts",
    "verify:version": "node scripts/check-version-consistency.mjs",
    "quality": "npm run verify:version && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.1.4"
  }
}
