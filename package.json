{
  "name": "praxis-online",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "check": "tsc --noEmit",
    "test:reports": "node --import tsx --test src/reporting.test.ts",
    "test:efficiency": "node --import tsx --test src/efficiency.test.ts",
    "test": "npm run test:reports && npm run test:efficiency",
    "report:sample": "node --import tsx scripts/generate-report-sample.ts",
    "report:scenarios": "node --import tsx scripts/generate-report-scenarios.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.1.4"
  }
}
